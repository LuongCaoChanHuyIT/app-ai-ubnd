# Chế độ môi trường ("production" sẽ tự động tắt /docs, /redoc, /openapi.json)
UBND_ENV=production

# Đường dẫn tệp cơ sở dữ liệu SQLite chính (cần gắn Persistent Volume cho thư mục cha)
UBND_DB_PATH=/var/lib/ubnd-ai/ubnd_ai.db

# Danh sách Origin của Frontend được phép gọi API (phân tách bằng dấu phẩy)
UBND_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Đặt =1 khi đứng sau Cloudflare Zero Trust Access để khóa xác thực qua Cf-Access-Authenticated-User-Email
UBND_TRUST_CF_ACCESS=0

