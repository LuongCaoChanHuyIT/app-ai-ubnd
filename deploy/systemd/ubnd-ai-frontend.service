[Unit]
Description=UBND AI Support - React Router SSR (:3000)
After=network.target ubnd-ai-backend.service

[Service]
Type=simple
WorkingDirectory=/opt/ubnd-ai/app
Environment="NODE_ENV=production"
Environment="PORT=3000"
Environment="API_BASE_URL=http://127.0.0.1:8000"
EnvironmentFile=-/etc/default/ubnd-ai
ExecStart=/usr/bin/env npm run start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

